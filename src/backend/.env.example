# Copy this file to `.env` (same folder) and fill GEMINI_API_KEY.
#   cp .env.example .env
# The backend loads `.env` automatically on startup.

# Public Firebase project id (used to verify login tokens — NOT a secret).
FIREBASE_PROJECT_ID=legaleaseai-25401

# Your OWN free Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides (defaults are fine):
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
